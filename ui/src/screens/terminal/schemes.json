    "nord":           { "name": "Nord",            "bg": "#2E3440", "fg": "#D8DEE9", "dim": "#7B88A1", "green": "#A3BE8C", "blue": "#81A1C1", "yellow": "#EBCB8B", "red": "#BF616A", "cursor": "#88C0D0", "bd": "#3B4252" },
